fn depth(n: int) -> int:
    return depth(n + 1) + 1

fn count_down(n: int) -> int:
    if n == 0:
        return 0
    return 1 + count_down(n - 1)

fn main() -> int:
    print(count_down(900))
    try:
        depth(0)
    except RecursionError as e:
        print("RecursionError")
    print(count_down(10))
    return 0
