fn main() -> int:
    array xs = [3, 1, 2]
    xs.append(9)
    print(xs)
    xs.sort()
    print(xs)
    xs.reverse()
    print(xs)
    print(xs.pop())
    print(xs.pop(0))
    print(xs)
    xs.insert(1, 7)
    xs.extend([5, 5])
    print(xs)
    print(xs.count(5))
    print(xs.index(7))
    xs.remove(5)
    print(xs)
    print(xs.contains(2))
    print(xs.contains(99))
    print(xs[1..3])
    xs.clear()
    print(len(xs))
    return 0
