type Point:
    fn __init__(self, x: int, y: int):
        self.x = x
        self.y = y

    fn __repr__(self) -> str:
        return "Point(" + str(self.x) + ", " + str(self.y) + ")"

fn main() -> int:
    print([Point(1, 2), Point(3, 4)])
    print(str(Point(5, 6)))
    print("at " + str(Point(0, 0)))
    return 0
