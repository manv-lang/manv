fn factorial(n: int) -> int:
    if n <= 1:
        return 1
    return n * factorial(n - 1)

fn fib(n: int) -> int:
    if n <= 1:
        return n
    return fib(n - 1) + fib(n - 2)

fn gcd(a: int, b: int) -> int:
    if b == 0:
        return a
    return gcd(b, a % b)

fn sum_to(n: int) -> int:
    if n == 0:
        return 0
    return n + sum_to(n - 1)

fn main() -> int:
    print(factorial(6))
    print(fib(10))
    print(gcd(48, 18))
    print(sum_to(100))
    return 0
