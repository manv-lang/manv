fn main() -> int:
    int base = 10
    fn add(x: int) -> int:
        return x + base
    fn fact(n: int) -> int:
        if n <= 1:
            return 1
        return n * fact(n - 1)
    print(add(5))
    print(fact(5))
    for i in 0..2:
        fn sq(v: int) -> int:
            return v * v
        print(sq(i + 3))
    return 0
