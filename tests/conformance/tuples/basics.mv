fn pair() -> tuple:
    return 1, "one"

fn empty() -> tuple:
    return ()

fn main() -> int:
    t = (1, 2, 3)
    print(t)
    print(len(t))
    print(t[0], t[-1])
    print(t[1..])
    print((7,))
    print(empty())
    print(len(empty()))
    print(pair())
    print((1, 2) == (1, 2))
    print((1, 2) == [1, 2])
    print((1, 2) < (1, 3))
    print(2 in t)
    print(9 not in t)
    print((1, 2) + (3,))
    for x in t:
        print(x)
    nested = ((1, 2), [3, 4])
    print(nested)
    print(("a", 1))
    return 0
