fn main() -> int:
    for i in 0..4:
        print(i)
    array nums = [10, 20, 30]
    for v in nums:
        print(v)
    for n in 0..10:
        if n == 3:
            break
        print(n)
    for p in 0..6:
        if p % 2 == 0:
            continue
        print(p)
    for a in 0..2:
        for b in 0..2:
            print(a * 10 + b)
    for q in 0..2:
        print(q)
    else:
        print("for-else ran")
    for r in 0..5:
        if r == 1:
            break
    else:
        print("never printed")
    for e in 0..0:
        print("empty range")
    print("done")
    return 0
