fn count(r) -> int:
    n = 0
    for i in r:
        n += 1
    return n

fn up_to_four(start):
    return start..4

fn main() -> int:
    r = 0..5
    print(r, len(r), r[1], r[-1])
    print(3 in r, 9 in r, r == (0..5), r == (0..6))
    s = 10..0 step -3
    print(s, sorted(s))
    for i in 0..10 step 4:
        print(i)
    for i in 5..0 step -2:
        print(i)
    print(range(3), range(1, 4), range(0, 10, 5))
    print(sum(1..5), count(2..8), count(8..2), count(0..0))
    print(r[1..3], [10, 20, 30, 40, 50][0..5 step 2], "abcdef"[.. step 2], "abcdef"[1..5 step 2])
    for n, i in enumerate(1..4):
        print(n, i)
    print(zip(0..3, ["a", "b", "c"]))
    big = 0..1000000
    total = 0
    for i in big:
        total += 1
    print(total, len(big))
    n = 3
    print(n..n + 2, (n)..(n + 2))
    try:
        for i in 0..5 step 0:
            pass
    except ValueError as e:
        print("step 0")
    try:
        x = up_to_four(1.5)
    except TypeError as e:
        print("float bound")
    return 0
