struct P:
    int a

fn pick(flag: bool) -> int:
    int result
    if flag:
        result = 1
    else:
        result = 2
    return result

fn early(flag: bool) -> int:
    int value
    if flag:
        return -1
    else:
        value = 5
    return value

fn guarded(n: int) -> str:
    str label
    match n:
        case 0:
            label = "zero"
        case _:
            label = "other"
    return label

fn attempt() -> int:
    int x
    try:
        x = int("7")
    except ValueError as e:
        x = -1
    return x

fn in_loop() -> int:
    int last
    last = 0
    for i in 0..3:
        last = i
    return last

fn main() -> int:
    int total
    total = pick(true) + pick(false) + early(false) + early(true)
    print(total, guarded(0), guarded(4), attempt(), in_loop())
    P p
    int* q
    int buf[2]
    print(p.a, q == null, buf[1])
    int n
    n = 3
    n += 1
    print(n)
    return 0
