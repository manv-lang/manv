fn main() -> int:
    big = 9223372036854775807
    print(big)
    try:
        print(big + 1)
    except OverflowError as e:
        print("overflow add")
    try:
        print(big * 2)
    except OverflowError as e:
        print("overflow mul")
    try:
        print(2 ** 63)
    except OverflowError as e:
        print("overflow pow")
    try:
        print(1 << 64)
    except OverflowError as e:
        print("overflow shift")
    print(-big - 1)
    try:
        print(-big - 2)
    except OverflowError as e:
        print("overflow sub")
    print(2 ** 62 + (2 ** 62 - 1))
    return 0
