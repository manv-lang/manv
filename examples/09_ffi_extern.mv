# ---
# 09_ffi_extern.mv
#
# Demonstrates ManV's C Foreign Function Interface (FFI).
#
#   - extern "c": block form declaring multiple C functions at once
#   - Pointer types in signatures: `u8*` is a C `unsigned char *`
#   - cstr(s)    -- turn a ManV string into a NUL-terminated C string
#   - null, ==   -- the null pointer and comparing pointers
#   - p + n      -- pointer arithmetic (scaled by the pointee size)
#
# A pointer returned by C code is "foreign": ManV does not know how big the block is,
# so accesses through it are not checked. Pointers from ManV's own malloc are checked
# (see 10_pointers.mv).
#
# Note: this file calls real libc functions (strlen, malloc, free). Memory from C's malloc
# must go back to C's free, and memory from ManV's malloc/cstr to ManV's free; they are
# named c_malloc/c_free here so the two cannot be mixed up.
# ---

# --- extern block: declare multiple C functions together ---
extern "c":
    fn strlen(s: u8*) -> int       # the byte length of a C string
    fn c_malloc(size: int) -> void* as "malloc"   # C's own malloc (foreign memory)
    fn c_free(p: void*) as "free"                 # only for memory from C's malloc

fn main() -> int:

    # --- cstr: a ManV string as a C char* ---
    u8* hello = cstr("Hello, FFI!")
    print(strlen(hello))               # 11 (bytes in "Hello, FFI!")
    print(str_from(hello))             # and back into a ManV string
    free(hello)                        # ManV's free: cstr memory belongs to ManV

    # --- null and comparison ---
    void* nothing = null
    if nothing == null:
        print("pointer is null")

    # --- malloc / free from C ---
    u8* buf = c_malloc(64) as u8*
    if buf == null:
        print("malloc failed")
        return 1
    print("malloc succeeded, buffer is not null")

    # --- pointer arithmetic: p + 8 is 8 bytes further for a u8* ---
    u8* later = buf + 8
    print(later - buf)                 # 8

    c_free(buf)
    print("buffer freed")
    return 0
