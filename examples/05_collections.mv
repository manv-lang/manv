# ---
# 05_collections.mv
#
# Demonstrates:
#   - Array literals, indexing, slicing
#   - len, sum, min, max, sorted, enumerate, zip
#   - Array methods (append, sort, ...) and index assignment
#   - Map literals, key access, methods (keys, values, has, ...)
#   - Tuples and unpacking in for loops
#   - Nested collections (an array of maps)
#
# Arrays and maps are shared, not copied: `b = a` makes both names refer to
# the same array, and `a.copy()` makes an independent one.
# ---

fn main() -> int:

    # --- Array literals and index access ---
    array nums = [10, 30, 20, 50, 40]
    print(nums[0])    # 10 (first element)
    print(nums[-1])   # 40 (negative indexes count from the end)

    # --- Built-in aggregate functions ---
    print(len(nums))      # 5
    print(sum(nums))      # 150
    print(min(nums))      # 10
    print(max(nums))      # 50
    print(sorted(nums))   # [10, 20, 30, 40, 50]

    # --- Slicing: a..b is "from a up to, not including, b" ---
    print(nums[1..4])   # [30, 20, 50]
    print(nums[..2])    # [10, 30]
    print(nums[3..])    # [50, 40]

    # --- enumerate gives (index, value) tuples; unpack them in the loop ---
    array letters = ["a", "b", "c"]
    for i, letter in enumerate(letters):
        print(i, letter)   # 0 a, 1 b, 2 c

    # --- zip pairs up arrays element by element ---
    array keys = ["x", "y", "z"]
    array vals = [1, 2, 3]
    for key, val in zip(keys, vals):
        print(key, val)    # x 1, y 2, z 3

    # --- Mutation: index assignment and methods ---
    array mutable = [1, 2, 3]
    mutable[1] = 99
    mutable.append(4)
    print(mutable)         # [1, 99, 3, 4]
    alias = mutable        # the same array, not a copy
    alias.append(5)
    print(mutable)         # [1, 99, 3, 4, 5]
    snapshot = mutable.copy()
    snapshot.append(6)
    print(len(mutable), len(snapshot))   # 5 6

    # --- Map literals and key access ---
    map person = {"name": "Alice", "age": 30}
    print(person["name"])   # Alice
    print(person["age"])    # 30

    # --- Check a key before reading it ---
    if person.has("age"):
        print("has age key")
    print(person.get("email", "no email"))   # a default for a missing key

    # --- keys, values and items ---
    print(person.keys())     # ['name', 'age']  (insertion order)
    print(person.values())   # ['Alice', 30]
    for k, v in person.items():
        print(k, "=", v)

    # --- Adding and updating map entries ---
    person["email"] = "alice@example.com"   # add a new key
    person["age"] = 31                       # update an existing key
    print(person["email"])
    print(person["age"])

    # --- Nested collections: an array of maps ---
    array users = []
    users.append({"name": "Bob", "score": 80})
    users.append({"name": "Carol", "score": 95})
    users.append({"name": "Dave", "score": 72})

    for user in users:
        print(f"{user['name']} scored {user['score']}")

    return 0
